#. module: lcc_cyclos_base
#: model:mail.template,body_html:lcc_cyclos_base.mail_template_cyclos_password_setup
msgid ""
"<div>\n"
"    <p>Hello <t t-out=\"object.partner_id.name or ''\"></t>,</p>\n"
"    <p>Your <t t-out=\"object.alt_currency_id.name or ''\"></t> wallet has been created.</p>\n"
"    <p>To choose your password, follow this link: <a t-att-href=\"ctx.get('cyclos_password_setup_link')\" t-out=\"ctx.get('cyclos_password_setup_link') or ''\"></a></p>\n"
"    <p>Your login is: <strong t-out=\"object.cyclos_login or ''\"></strong></p>\n"
"    <p>This link remains valid until you have chosen your password.</p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <p>Bonjour <t t-out=\"object.partner_id.name or ''\"></t>,</p>\n"
"    <p>Votre portefeuille <t t-out=\"object.alt_currency_id.name or ''\"></t> a été créé.</p>\n"
"    <p>Pour choisir votre mot de passe, suivez ce lien : <a t-att-href=\"ctx.get('cyclos_password_setup_link')\" t-out=\"ctx.get('cyclos_password_setup_link') or ''\"></a></p>\n"
"    <p>Votre identifiant est : <strong t-out=\"object.cyclos_login or ''\"></strong></p>\n"
"    <p>Ce lien reste valable jusqu'à ce que vous ayez choisi votre mot de passe.</p>\n"
"</div>\n"
"            "

