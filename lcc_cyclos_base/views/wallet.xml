<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wallet_cyclos_form_view" model="ir.ui.view">
        <field name="name">wallet.cyclos.form.view</field>
        <field name="model">res.partner.backend</field>
        <field name="inherit_id" ref="lcc_lokavaluto_app_connection.wallet_form_view" />
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='general_info']" position="after">
                <group name="cyclos_specific" string="Cyclos specific"
                    attrs="{'invisible': [('type','!=','cyclos')]}">
                    <field name="cyclos_id" />
                    <field name="cyclos_login" />
                    <field name="cyclos_password_pending" />
                    <field name="cyclos_status" />
                    <field name="cyclos_create_response" />
                </group>
                <footer>
                    <button name="cyclos_validate_user" type="object"
                        string="Validate Cyclos Wallet" class="oe_highlight"
                        attrs="{'invisible': ['|',('type','!=','cyclos'),('cyclos_status','!=','pending')]}" />
                    <button name="cyclos_activate_user" type="object"
                        string="Activate Cyclos Wallet" class="oe_highlight"
                        attrs="{'invisible': ['|',('type','!=','cyclos'),('cyclos_status','=','active')]}" />
                    <button name="cyclos_block_user" type="object" string="Block Cyclos Wallet"
                        class="oe_highlight"
                        attrs="{'invisible': ['|',('type','!=','cyclos'),('cyclos_status','=','blocked')]}" />
                    <button name="cyclos_disable_user" type="object" string="Disable Cyclos Wallet"
                        class="oe_highlight"
                        attrs="{'invisible': ['|',('type','!=','cyclos'),('cyclos_status','=','disabled')]}" />
                    <button name="cyclos_sync_user_fields" type="object"
                        string="Synchronize to Cyclos"
                        attrs="{'invisible': ['|',('type','!=','cyclos'),('cyclos_id','=',False)]}" />
                    <button name="cyclos_send_password_setup_email" type="object"
                        string="Send password setup e-mail"
                        attrs="{'invisible': ['|',('type','!=','cyclos'),('cyclos_password_pending','=',False)]}" />
                </footer>
            </xpath>

        </field>
    </record>

</odoo>