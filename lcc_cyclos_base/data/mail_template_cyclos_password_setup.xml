<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_cyclos_password_setup" model="mail.template">
            <field name="name">Cyclos wallet: set your password</field>
            <field name="model_id" ref="lcc_lokavaluto_app_connection.model_res_partner_backend" />
            <field name="subject">Your {{ object.alt_currency_id.name }} wallet: set your password</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True" />
            <field name="body_html" type="html">
<div>
    <p>Hello <t t-out="object.partner_id.name or ''" />,</p>
    <p>Your <t t-out="object.alt_currency_id.name or ''" /> wallet has been created.</p>
    <p>To choose your password, follow this link: <a t-att-href="ctx.get('cyclos_password_setup_link')" t-out="ctx.get('cyclos_password_setup_link') or ''" /></p>
    <p>Your login is: <strong t-out="object.cyclos_login or ''" /></p>
    <p>This link remains valid until you have chosen your password.</p>
</div>
            </field>
        </record>
    </data>
</odoo>
