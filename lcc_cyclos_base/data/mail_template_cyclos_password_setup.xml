<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_cyclos_password_setup" model="mail.template">
            <field name="name">Cyclos wallet: set your password</field>
            <field name="model_id" ref="lcc_lokavaluto_app_connection.model_res_partner_backend" />
            <field name="subject">Your {{ object.alt_currency_id.name }} wallet: set your password</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="False" />
            <field name="body_html" type="html">
<div>
    <p>Hello <t t-out="object.partner_id.name or ''" />,</p>
    <p>Your <t t-out="object.alt_currency_id.name or ''" /> wallet has been created. To choose your password:</p>
    <ol>
        <li>open <a t-att-href="object.alt_currency_id.cyclos_password_setup_url" t-out="object.alt_currency_id.cyclos_password_setup_url or ''" />,</li>
        <li>enter your login: <strong t-out="object.cyclos_login or ''" />,</li>
        <li>enter the code you will then receive by e-mail (it is valid for one hour),</li>
        <li>choose your password.</li>
    </ol>
</div>
            </field>
        </record>
    </data>
</odoo>
